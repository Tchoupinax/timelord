{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "API_URL",
    "FNOX_PROFILE",
    "TIMELORD_REMOTE_API"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:e2e": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "watch:prod": {
      "cache": false,
      "persistent": true
    },
    "watch:front": {
      "cache": false,
      "persistent": true
    }
  }
}
