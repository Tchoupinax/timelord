AGENT_MASTER_TOKEN="agent-master-token-for-dev"
AGENT_TOKEN=
API_URL="http://localhost:9988"
CI_COMMIT_SHA="random"
CI_PIPELINE_CREATED="1730421126"
# Postgres connection (see server/src/tools/database-url.mts):
# - DATABASE_URL in this file overrides fnox when you run `pnpm watch` (env-preload.mts).
# - If DATABASE_URL is unset, the URL is built from POSTGRES_* (local Docker / fnox).
DATABASE_URL="postgres://postgres:mysecret@localhost:5439/postgres"
# fnox injects POSTGRES_* (see ../fnox.toml). Production API + DB via Vault:
#   FNOX_PROFILE=production pnpm --filter @timelord/server watch:prod
DISABLE_AUTHENTICATION="true"
GIT_CONFIGS_REPOSITORY="tmp"
HOMEPAGE_TOKEN=
JOB_DEFAULT_TIMEOUT="30m"
CRON_START_WINDOW_MINUTES=5
LOG_LEVEL="debug"
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CONFIGURATION_URL=
OIDC_PROVIDER_IMAGE=
OIDC_PROVIDER_NAME=
POSTGRES_DATABASE="postgres"
POSTGRES_HOSTNAME="localhost"
POSTGRES_PASSWORD="mysecret"
POSTGRES_PORT="5439"
POSTGRES_USERNAME="postgres"
SSH_KEYS_REPOSITORY="tmp"
UI_URL="http://localhost:3000"
VAULT_ADDR="http://localhost:8200"
VAULT_PATH="kv/data/timelord"
VAULT_TOKEN="root"
