// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id                   String   @id @default(uuid())
  hostname             String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  Log                  Log[]
  title                String?
  cron                 String? /// DEBUG purpose, the cron word
  statusCode           Int? @map("status_code") /// End status code of the bash script
  userId               String?  @map("user_id")
  statusComment        String? @map("status_comment") /// Provide custom comment about the end status of the job
  nextPlannedExecution String? @map("next_planned_execution") /// String date when the next execution was planned. Used to detect duplicate
  finalState           String? @map("final_state") /// Script-reported state: Success, Warning, Error (from TIMELORD_OUTPUT_STATE)

  @@map("jobs")
}

model Log {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  jobId     String   @map("job_id")
  index     Int
  type      String
  userId    String?  @map("user_id")

  @@map("logs")
}

model Secret {
  id        String    @id @default(uuid())
  name      String    @unique
  value     String
  comment   String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  lastRead  DateTime? @map("last_read")
  userId    String?   @map("user_id")

  @@map("secrets")
}

model Agent {
  id        String    @id @default(uuid())
  name      String    @unique
  userId    String    @map("user_id")
  token     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  seenAt    DateTime? @map("seen_at")
  version   String?

  @@map("agents")
}

model GitConfig {
  id                        String    @id @default(uuid())
  name                      String    @unique
  userId                    String    @map("user_id")
  sshPrivateKey             String    @map("ssh_private_key")
  sshUrl                    String    @map("ssh_url")
  folderNameInGitRepository String    @default("timelord") @map("folder_name_in_git_repository")
  enabled                   Boolean
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  pullAt                    DateTime? @map("pull_at")

  @@map("git_configs")
}

model JobQueue {
  title     String
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id(name: "jobId", [title, userId])

  @@map("job_queue")
}

model User {
  id                  String @id @default(uuid())
  email               String
  masterTokenForAgent String @map("master_token_for_agent")

  @@map("users")
}
