{
  "name": "@timelord/server",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm migrate && pnpm generate && tsc",
    "build:ci": "pnpm generate && tsc",
    "inspect": "node-modules-inspector",
    "lint": "eslint --fix .",
    "migrate": "DATABASE_URL=postgres://postgres:mysecret@localhost:5439/postgres npx prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "DATABASE_URL=postgres://postgres:mysecret@localhost:5439/postgres npx prisma db seed",
    "simulate-live-logs": "fnox exec -- npx tsx scripts/simulate-live-logs.mts",
    "studio": "fnox exec -- prisma studio",
    "studio:prod": "fnox exec --profile production -- prisma studio",
    "test": "vitest run --config test/config/vitest.unit.config.mts",
    "test:e2e": "vitest run --config test/config/vitest.e2e.config.mts",
    "test:e2e:watch": "vitest --config test/config/vitest.e2e.config.mts --ui",
    "test:integration": "pnpm test:e2e",
    "test:integration:watch": "pnpm test:e2e:watch",
    "test:watch": "vitest --config test/config/vitest.unit.config.mts --ui",
    "=================================================================": "",
    "generate": "npx prisma generate",
    "==================================================================": "",
    "prewatch": "docker compose up -d && pnpm migrate dev && pnpm generate",
    "watch": "fnox exec -- tsx watch --require ./env-preload.mts src/index.mts",
    "watch:prod": "fnox exec --profile production -- tsx watch --require ./env-preload.mts src/index.mts",
    "start": "fnox exec -- tsx --require ./env-preload.mts src/index.mts",
    "start:prod": "fnox exec --profile production -- tsx --require ./env-preload.mts src/index.mts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/formbody": "9.0.0",
    "@fastify/request-context": "7.0.0",
    "@fastify/session": "11.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "archiver": "8.0.0",
    "axios": "1.20.0",
    "cron-parser": "5.10.1",
    "dayjs": "1.11.23",
    "fastify": "5.12.5",
    "node-vault": "0.12.0",
    "pino": "10.3.1",
    "prisma": "7.10.0",
    "prom-client": "15.1.3",
    "simple-git": "3.36.0",
    "ts-pattern": "5.9.0",
    "tsx": "4.23.13",
    "valienv": "1.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@swc/core": "1.16.2",
    "@types/archiver": "8.0.0",
    "@types/node": "26.2.0",
    "@vitest/ui": "5.0",
    "eslint": "10.10.0",
    "eslint-config-tchoupinax": "2.6.1",
    "node-modules-inspector": "2.7.0",
    "pino-pretty": "13.1.3",
    "typescript": "6",
    "unplugin-swc": "1.6.0",
    "vite-node": "6.0.0",
    "vitest": "5.0",
    "vitest-mock-extended": "5.1.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "imports": {
    "#prisma": "./prisma/generated/prisma/index.d.ts",
    "#prisma-run": "./prisma/generated/prisma/index.js",
    "#src/*": "./src/*"
  }
}
