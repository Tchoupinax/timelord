{
  "name": "@timelord/server",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm migrate && pnpm generate && tsc",
    "build:ci": "pnpm generate && tsc",
    "inspect": "node-modules-inspector",
    "lint": "eslint --fix .",
    "migrate": "DATABASE_URL=postgres://postgres:mysecret@localhost:5439/postgres npx prisma migrate dev",
    "seed": "DATABASE_URL=postgres://postgres:mysecret@localhost:5439/postgres npx prisma db seed",
    "studio": "npx prisma studio",
    "test": "vitest --config test/config/vitest.unit.config.mts",
    "test:integration": "docker compose -f test/infra/docker-compose.yml up -d && export DATABASE_URL=postgres://postgres:mysecret@localhost:5438/postgres && npx prisma migrate dev && vitest run --config test/config/vitest.integration.config.mts",
    "test:integration:watch": "docker compose -f test/infra/docker-compose.yml up -d && export DATABASE_URL=postgres://postgres:mysecret@localhost:5438/postgres && npx prisma migrate dev && vitest run --config test/config/vitest.integration.config.mts --ui",
    "test:watch": "vitest --config test/config/vitest.unit.config.mts --ui",
    "=================================================================": "",
    "generate": "npx prisma generate",
    "==================================================================": "",
    "prewatch": "docker compose up -d && pnpm migrate dev && pnpm generate",
    "watch": "tsx watch --require dotenv/config src/index.mts",
    "start": "tsx src/index.mts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/formbody": "8.0.2",
    "@fastify/request-context": "6.2.1",
    "@fastify/session": "11.1.1",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "archiver": "7.0.1",
    "axios": "1.15.2",
    "cron-parser": "5.5.0",
    "dayjs": "1.11.20",
    "fastify": "5.8.5",
    "node-vault": "0.12.0",
    "pino": "10.3.1",
    "prisma": "7.8.0",
    "prom-client": "15.1.3",
    "simple-git": "3.36.0",
    "ts-pattern": "5.9.0",
    "valienv": "1.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@swc/core": "1.15.32",
    "@types/archiver": "7.0.0",
    "@types/node": "25.6.0",
    "@vitest/ui": "4.1",
    "eslint": "10.2.1",
    "eslint-config-tchoupinax": "2.5.0",
    "node-modules-inspector": "1.4.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.9",
    "vite-node": "6.0.0",
    "vitest": "4.1",
    "vitest-mock-extended": "4.0.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "imports": {
    "#prisma": "./prisma/generated/prisma/index.d.ts",
    "#prisma-run": "./prisma/generated/prisma/index.js"
  }
}
