{
  "name": "timelord-server",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "inspect": "node-modules-inspector",
    "lint": "eslint \"{src,apps,libs,test}/**/*.{ts,mts}\" --fix",
    "migrate": "DATABASE_URL=postgres://postgres:mysecret@localhost:5439/postgres npx prisma migrate dev",
    "seed": "DATABASE_URL=postgres://postgres:mysecret@localhost:5439/postgres npx prisma db seed",
    "studio": "npx prisma studio",
    "test": "vitest --config test/config/vitest.unit.config.ts",
    "test:integration": "docker compose -f test/infra/docker-compose.yml up -d && export DATABASE_URL=postgres://postgres:mysecret@localhost:5438/postgres && npx prisma migrate dev && vitest run --config test/config/vitest.integration.config.ts",
    "test:integration:watch": "docker compose -f test/infra/docker-compose.yml up -d && export DATABASE_URL=postgres://postgres:mysecret@localhost:5438/postgres && npx prisma migrate dev && vitest run --config test/config/vitest.integration.config.ts --ui",
    "test:watch": "vitest --config test/config/vitest.unit.config.ts --ui",
    "=================================================================": "",
    "generate": "npx prisma generate",
    "==================================================================": "",
    "prewatch": "docker compose up -d && npx prisma generate",
    "watch": "tsx watch --require dotenv/config src/index.mts",
    "start": "tsx src/index.mts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/formbody": "8.0.2",
    "@fastify/request-context": "6.2.1",
    "@fastify/session": "11.1.1",
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "@prisma/client-runtime-utils": "7.3.0",
    "archiver": "7.0.1",
    "axios": "1.13.4",
    "cron-parser": "5.5.0",
    "dayjs": "1.11.19",
    "fastify": "5.7.4",
    "node-vault": "0.10.9",
    "pino": "10.3.0",
    "prisma": "7.3.0",
    "prom-client": "15.1.3",
    "simple-git": "3.30.0",
    "ts-pattern": "5.9.0",
    "valienv": "1.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@swc/core": "1.15.11",
    "@types/archiver": "7.0.0",
    "@types/node": "25.2.2",
    "@vitest/ui": "4.0",
    "eslint": "10.0.0",
    "eslint-plugin-jsonc": "2.21.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "node-modules-inspector": "1.3.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "unplugin-swc": "1.5.9",
    "vite-node": "5.3.0",
    "vitest": "4.0",
    "vitest-mock-extended": "3.1.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "imports": {
    "#prisma": "./prisma/generated/prisma/index.d.ts",
    "#prisma-run": "./prisma/generated/prisma/index.js"
  }
}
