{
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "up": "docker compose up -d && scripts/vault-setup.sh",
    "build": "turbo run build",
    "prewatch": "pnpm run up",
    "watch": "turbo run watch",
    "watch:prod": "FNOX_PROFILE=production turbo run watch:prod",
    "watch:front": "pnpm --filter @timelord/ui watch:front",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @timelord/server test:e2e",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "knip": "knip",
    "upgrade": "npx ncu -i -w",
    "check": "gitleaks dir -v && gitleaks git -v"
  },
  "devDependencies": {
    "knip": "6.32.2",
    "npm-check-updates": "23.0.2",
    "turbo": "2.10.10"
  },
  "packageManager": "pnpm@11.22.0"
}
