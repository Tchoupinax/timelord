{
  "name": "toto",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "up": "docker compose up -d && scripts/vault-setup.sh",
    "build": "turbo run build",
    "prewatch": "pnpm run up",
    "watch": "turbo run watch",
    "test": "turbo run test",
    "lint": "prettier -w . && turbo run lint",
    "check-types": "turbo run check-types",
    "knip": "knip",
    "upgrade": "npx ncu -i -w",
    "check": "gitleaks dir -v && gitleaks git -v"
  },
  "devDependencies": {
    "knip": "5.83.1",
    "npm-check-updates": "19.3.2",
    "prettier": "3.8.1",
    "turbo": "2.8.7"
  },
  "packageManager": "pnpm@10.29.3"
}
