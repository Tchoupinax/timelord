{
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnSave": true
  },
  "[vue]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "kennylong.kubernetes-yaml-formatter",
    "editor.formatOnSave": true
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always",
    "source.organizeImports": "never"
  },
  "eslint.format.enable": true,
  "yaml.format.singleQuote": false,
  "yaml.format.bracketSpacing": false,

  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#fffddd",
    "activityBar.background": "#fffddd",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#00bfb4",
    "activityBarBadge.foreground": "#15202b",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#fffddd",
    "statusBar.background": "#fffbaa",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#fff977",
    "statusBarItem.remoteBackground": "#00bfb6",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#fffbaa",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#fffbaa99",
    "titleBar.inactiveForeground": "#15202b99",
    "activityBarTop.activeBackground": "#fffddd",
    "activityBarTop.background": "#fffddd",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.foreground": "#15202b",
    "statusBar.debuggingBackground": "#fffbaa",
    "statusBar.debuggingForeground": "#15202b"
  },
  "peacock.color": "#FFFBAA"
}
